# ─── MongoDB ───
MONGODB_URI=mongodb://localhost:27017/posture_coach

# ─── Express Session ───
SESSION_SECRET=change-this-to-a-strong-random-string

# ─── Server ───
PORT=5000
NODE_ENV=development

# ─── CORS ───
CLIENT_URL=http://localhost:5173

# ─── Python Vision Service ───
VISION_SERVICE_URL=http://localhost:8000

# ─── Internal API (Python → Express) ───
# This is auto-generated per tracking session; no manual config needed.

# ─── Backup ───
BACKUP_DIR=./backups
BACKUP_CRON=0 3 * * *

# ─── Development Overrides (uncomment for faster testing) ───
# BAD_ALERT_THRESHOLD_SECONDS=5
# BAD_ALERT_REPEAT_SECONDS=10
